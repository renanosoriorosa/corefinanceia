{
  "ConnectionStrings": {
    "DefaultConnection": "user=sa;pwd=SQLServerDocker@;Data Source=localhost,1433;Initial Catalog=CoreFinance;MultipleActiveResultSets=True;Application Name=EF-CORE;TrustServerCertificate=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "corefinance-api" },
            { "key": "env", "value": "local" }
          ],
          "propertiesAsLabels": [ "level" ],
          "textFormatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Observability": {
    "Enabled": true
  },
  "HealthChecks": {
    "SqlServer": {
      "TimeoutEmSegundos": 5
    }
  },
  "Jwt": {
    "Key": "corefinance-chave-de-desenvolvimento-com-mais-de-32-caracteres",
    "Issuer": "CoreFinance",
    "Audience": "CoreFinance",
    "ExpiraEmMinutos": 480
  }
}
